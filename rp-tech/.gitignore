# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la plantilla: documenta que variables necesita el proyecto.
# El sistema anterior documentaba 5 variables mientras el codigo leia 12.
!.env.example

# Credenciales locales del panel admin. Contienen una contrasena en claro.
.admin-credentials.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imagenes generadas por scripts/optimizar-imagenes.sh (artefacto de build, no fuente)
scripts/imagenes/

# Costos reales: revelan el margen de cada producto y este repo puede ser publico.
scripts/data/costos.local.json
